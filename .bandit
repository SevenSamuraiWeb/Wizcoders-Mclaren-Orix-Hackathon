# Bandit Security Configuration
# Configuration for security linting

# Exclude tests and development files
exclude_dirs:
  - tests
  - venv
  - .venv

# Test IDs to skip
skips:
  - B101  # assert_used - assertions are OK in tests
  - B601  # paramiko_calls - SSH operations

# Common issues to check
tests:
  - B201  # flask_debug_true
  - B301  # pickle
  - B302  # marshal
  - B303  # md5
  - B304  # cipher
  - B305  # cipher
  - B306  # mktemp
  - B307  # eval
  - B308  # mark_safe
  - B309  # httpsconnection
  - B310  # urllib_urlopen
  - B311  # random
  - B312  # telnetlib
  - B313  # xml_bad_expat
  - B314  # xml_bad_etree
  - B315  # xml_bad_sax
  - B316  # xml_bad_pulldom
  - B317  # xml_bad_etree
  - B318  # xml_bad_etree
  - B319  # xml_bad_etree
  - B320  # xml_bad_etree
  - B321  # ftplib
  - B322  # input
  - B323  # unverified_context
  - B324  # probable_insecure_hash_usage
  - B325  # temporary_file_q_arg
  - B601  # paramiko_calls
  - B602  # subprocess_popen_with_shell_equals_true
  - B603  # subprocess_without_shell_equals_true
  - B604  # unix_command_wildcard_injection
  - B605  # start_process_with_a_shell
  - B606  # start_process_with_no_shell
  - B607  # partial_paramiko_calls
  - B608  # hardcoded_sql_string
  - B609  # wildcard_injection
  - B610  # django_sql_injection
  - B611  # django_sql_injection_extra
  - B701  # jinja2_autoescape_false
  - B702  # mako_templates
  - B703  # django_mark_safe
