# ============================================================================
# MSS Financial Analysis Platform - Environment Configuration Template
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in actual values
# NEVER commit the .env file to version control!
# ============================================================================

# ============================================================================
# API & Backend Configuration
# ============================================================================

# FastAPI settings
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO

# Server settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================================================
# Security & Authentication
# ============================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Configuration (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# ============================================================================
# External APIs
# ============================================================================

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ============================================================================
# Database Configuration (if applicable)
# ============================================================================

# PostgreSQL (example)
DATABASE_URL=postgresql://username:password@localhost:5432/mss_db
DATABASE_POOL_SIZE=10
DATABASE_ECHO=False

# MongoDB (example)
# MONGODB_URL=mongodb://username:password@localhost:27017/mss_db

# ============================================================================
# File Upload Configuration
# ============================================================================

# Maximum file size (in bytes) - Default: 50MB
MAX_FILE_SIZE=52428800

# Allowed file types (comma-separated)
ALLOWED_EXTENSIONS=.pdf

# Upload directory
UPLOAD_DIR=./uploads

# ============================================================================
# Frontend Configuration
# ============================================================================

# API Base URL for frontend
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DARK_MODE=true

# ============================================================================
# Third-Party Services
# ============================================================================

# Google Analytics (optional)
# GOOGLE_ANALYTICS_ID=

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://...@sentry.io/...

# AWS S3 Configuration (if using S3 for file storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=mss-documents

# ============================================================================
# Email Configuration (for notifications/reports)
# ============================================================================

# SMTP Settings
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@mss.example.com

# ============================================================================
# Monitoring & Analytics
# ============================================================================

# Application Insights (Azure)
# APPINSIGHTS_INSTRUMENTATION_KEY=

# DataDog
# DATADOG_API_KEY=
# DATADOG_APP_KEY=

# ============================================================================
# Development Tools
# ============================================================================

# Testing
PYTEST_ARGS=--cov=src --cov-report=html

# Code Quality
BLACK_LINE_LENGTH=100
PYLINT_DISABLE=too-few-public-methods,too-many-arguments

# ============================================================================
# Notes for Different Environments
# ============================================================================

# DEVELOPMENT:
# - DEBUG=True (for detailed error pages)
# - ALLOWED_ORIGINS can be broad (localhost:*, 127.0.0.1)
# - CORS_CREDENTIALS=true for local testing
# - JWT_SECRET can be simple

# STAGING:
# - DEBUG=False
# - ALLOWED_ORIGINS should be specific staging domain
# - Use staging API keys
# - Enable monitoring and logging
# - Enforce HTTPS=true

# PRODUCTION:
# - DEBUG=False
# - ALLOWED_ORIGINS must be specific production domain(s)
# - Use production API keys with restricted permissions
# - Enable all monitoring, logging, and error tracking
# - Enforce HTTPS=true
# - Set SECURE_COOKIES=true
# - Use strong JWT_SECRET (64+ characters)
# - Enable rate limiting
# - Enable WAF (Web Application Firewall)

# ============================================================================
# Security Reminders
# ============================================================================
# - All API keys should be service-specific with minimal permissions
# - Rotate JWT_SECRET periodically
# - Use different values for development vs. production
# - For production, use a secrets management service (AWS Secrets Manager, Azure Key Vault)
# - Ensure .env is in .gitignore (NEVER commit actual values)
# - Review and update this template annually
# ============================================================================
